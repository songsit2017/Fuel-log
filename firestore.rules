rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function vehicleDoc(vehicleId){ return get(/databases/$(database)/documents/vehicles/$(vehicleId)); }
    function isMember(vehicleId){ return signedIn() && (vehicleDoc(vehicleId).data.ownerUid == request.auth.uid || vehicleDoc(vehicleId).data.members[request.auth.uid].role in ['owner','editor','viewer']); }
    function canEdit(vehicleId){ return signedIn() && (vehicleDoc(vehicleId).data.ownerUid == request.auth.uid || vehicleDoc(vehicleId).data.members[request.auth.uid].role in ['owner','editor']); }
    function isOwner(vehicleId){ return signedIn() && vehicleDoc(vehicleId).data.ownerUid == request.auth.uid; }
    match /users/{uid}{ allow read,write: if signedIn() && request.auth.uid == uid; }
    match /vehicles/{vehicleId}{
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.members[request.auth.uid].role in ['owner','editor','viewer']);
      allow update,delete: if isOwner(vehicleId);
      match /{collection}/{docId}{
        allow read: if isMember(vehicleId);
        allow create,update: if canEdit(vehicleId);
        allow delete: if canEdit(vehicleId);
      }
    }
    match /invites/{code}{
      allow create: if signedIn();
      allow read: if signedIn();
      allow delete: if signedIn();
      allow update: if false;
    }
  }
}
