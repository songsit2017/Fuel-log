rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function vdoc(vid){ return get(/databases/$(database)/documents/vehicles/$(vid)); }
    function member(vid){ return signedIn() && vdoc(vid).data.members[request.auth.uid].role in ['owner','editor','viewer']; }
    function edit(vid){ return signedIn() && vdoc(vid).data.members[request.auth.uid].role in ['owner','editor']; }
    function owner(vid){ return signedIn() && vdoc(vid).data.ownerUid == request.auth.uid; }
    match /users/{uid} { allow read,write: if signedIn() && request.auth.uid == uid; }
    match /vehicles/{vid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if member(vid);
      allow delete: if owner(vid);
      allow update: if owner(vid) || (signedIn() && request.resource.data.lastJoinCode is string && exists(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)) && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.vehicleId == vid && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.emailLower == request.auth.token.email);
      match /{document=**} { allow read: if member(vid); allow create, update: if edit(vid); allow delete: if edit(vid); }
    }
    match /invites/{code} { allow create: if signedIn(); allow read: if signedIn(); allow update,delete: if false; }
  }
}
