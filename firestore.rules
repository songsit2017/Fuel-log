// ============================================================================
// AI AGENT WARNING: FIREBASE SYNC AND FAMILY-SHARING SECURITY BOUNDARY
// These rules must stay aligned with FirestoreSyncRepository, vehicle sharing,
// Cloud Function membership checks, and /ARCHITECTURE.md. A schema change without
// matching rules can expose data or break the Fuel Log -> PU Pocket bridge.
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function vehicleExists(vid) { return exists(/databases/$(database)/documents/vehicles/$(vid)); }
    function vehicleDoc(vid) { return get(/databases/$(database)/documents/vehicles/$(vid)); }
    function member(vid) { return signedIn() && vehicleExists(vid) && vehicleDoc(vid).data.members[request.auth.uid].role in ['owner','editor','viewer']; }
    function editor(vid) { return signedIn() && vehicleExists(vid) && vehicleDoc(vid).data.members[request.auth.uid].role in ['owner','editor']; }
    function owner(vid) { return signedIn() && vehicleExists(vid) && vehicleDoc(vid).data.ownerUid == request.auth.uid; }
    // Lets an existing (non-owner) member refresh their own name/photo — e.g. after signing
    // in with a Google account that now has a profile photo — without needing a fresh invite
    // code. Only the caller's own members.{uid} entry may change, and their role must stay
    // the same, so this can't touch anyone else's membership or self-promote.
    function selfProfileRefresh(vid) {
      return member(vid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.members[request.auth.uid].role == resource.data.members[request.auth.uid].role;
    }
    function canReadVehicleResource() {
      return signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.members[request.auth.uid].role in ['owner','editor','viewer'] ||
        request.auth.uid in resource.data.memberUids
      );
    }

    match /users/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }
    match /vehicles/{vid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.members[request.auth.uid].role == 'owner';
      // Resource-field checks allow Firestore to prove ownerUid == uid and
      // memberUids array-contains uid queries without exposing other vehicles.
      allow read: if canReadVehicleResource();
      allow delete: if owner(vid);
      allow update: if owner(vid) || selfProfileRefresh(vid) || (signedIn() && request.resource.data.lastJoinCode is string && exists(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)) && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.vehicleId == vid && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.emailLower == request.auth.token.email && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.expiresAt > request.time.toMillis());
      match /{document=**} {
        allow read: if member(vid);
        allow create, update: if editor(vid);
        allow delete: if editor(vid);
      }
    }
    match /invites/{code} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.emailLower == request.auth.token.email);
      allow update, delete: if false;
    }
  }
}
