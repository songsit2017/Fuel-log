rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function vehicleExists(vid) {
      return exists(/databases/$(database)/documents/vehicles/$(vid));
    }

    function vehicleDoc(vid) {
      return get(/databases/$(database)/documents/vehicles/$(vid));
    }

    function member(vid) {
      return signedIn()
        && vehicleExists(vid)
        && vehicleDoc(vid).data.members[request.auth.uid].role in ['owner', 'editor', 'viewer'];
    }

    function editor(vid) {
      return signedIn()
        && vehicleExists(vid)
        && vehicleDoc(vid).data.members[request.auth.uid].role in ['owner', 'editor'];
    }

    function owner(vid) {
      return signedIn()
        && vehicleExists(vid)
        && vehicleDoc(vid).data.ownerUid == request.auth.uid;
    }

    function validInviteJoin(vid) {
      let code = request.resource.data.lastJoinCode;
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return signedIn()
        && code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && invite.vehicleId == vid
        && invite.emailLower == request.auth.token.email
        && invite.expiresAt > request.time.toMillis()
        && invite.role in ['editor', 'viewer']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'lastJoinCode', 'updatedAt'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == invite.role
        && request.resource.data.members[request.auth.uid].emailLower == invite.emailLower;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /vehicles/{vid} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[request.auth.uid].role == 'owner';

      allow read: if member(vid);
      allow delete: if owner(vid);
      allow update: if owner(vid) || validInviteJoin(vid);

      match /{document=**} {
        allow read: if member(vid);
        allow create, update, delete: if editor(vid);
      }
    }

    match /invites/{code} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.emailLower is string;

      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.emailLower == request.auth.token.email);

      allow update, delete: if false;
    }
  }
}
