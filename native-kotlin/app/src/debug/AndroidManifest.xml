<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest additions, merged on top of src/main/AndroidManifest.xml only for the
  ".dev" build (see build.gradle.kts) — the production app is untouched.

  Registers MainActivity as a share target for photos, so "FuelLog Pro Dev" shows up in the
  system share sheet when sharing a receipt photo from Gallery/Camera/LINE/etc. Handled in
  MainActivity.onCreate (checks intent.action == ACTION_SEND / ACTION_SEND_MULTIPLE).

  Both SEND and SEND_MULTIPLE are registered — some gallery apps (Samsung Gallery included) fire
  SEND_MULTIPLE even for a single selected photo, so an app that only declares SEND silently
  never appears in that gallery's share sheet even though it works fine from apps that use plain
  SEND (confirmed via `adb shell am start -a android.intent.action.SEND ...`, which did show this
  app in the chooser).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
