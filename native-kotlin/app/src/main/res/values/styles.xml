<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat-derived (not the plain platform Theme.Material) — MainActivity is now an
         AppCompatActivity so AppCompatDelegate.setApplicationLocales() (per-app language) works;
         AppCompatActivity throws at runtime if the applied theme isn't Theme.AppCompat-derived. -->
    <style name="Theme.FuelLogPro" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#111318</item>
        <item name="android:statusBarColor">#1E2945</item>
    </style>

    <!-- Daytime splash: plain white background (same backdrop the launcher icon itself already
         sits on), so the icon just reads as branding rather than a heavy block of color. -->
    <style name="Theme.FuelLogPro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/fuellog_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FuelLogPro</item>
    </style>
</resources>

