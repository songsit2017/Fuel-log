rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function vehicleDoc(vehicleId){ return firestore.get(/databases/(default)/documents/vehicles/$(vehicleId)); }
    function role(vehicleId){ return vehicleDoc(vehicleId).data.ownerUid == request.auth.uid ? 'owner' : vehicleDoc(vehicleId).data.members[request.auth.uid].role; }
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if signedIn() && role(vehicleId) in ['owner','editor','viewer'];
      allow create,update: if signedIn() && role(vehicleId) in ['owner','editor'] && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('(image/.*|application/pdf)');
      allow delete: if signedIn() && role(vehicleId) in ['owner','editor'];
    }
  }
}
