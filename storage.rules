rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member(vehicleId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/vehicles/$(vehicleId)/members/$(request.auth.uid));
    }
    function editor(vehicleId) {
      return member(vehicleId) && firestore.get(/databases/(default)/documents/vehicles/$(vehicleId)/members/$(request.auth.uid)).data.role in ['owner','editor'];
    }

    match /vehicles/{vehicleId}/entries/{entryId}/{fileName} {
      allow read: if member(vehicleId);
      allow create, update: if editor(vehicleId) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if editor(vehicleId);
    }
  }
}
